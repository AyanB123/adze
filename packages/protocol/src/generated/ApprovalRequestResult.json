{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow-once",
        "allow-session",
        "deny",
        "abort"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "decision"
  ],
  "additionalProperties": false
}
