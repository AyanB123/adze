{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "read-only",
        "workspace-write",
        "full-access"
      ]
    },
    "writableRoots": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedNetworkHosts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commandRules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "allow",
              "prompt",
              "forbid"
            ]
          }
        },
        "required": [
          "prefix",
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "mode"
  ],
  "additionalProperties": false
}
