{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "full-access"
          ]
        },
        "writableRoots": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedNetworkHosts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commandRules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "enum": [
                  "allow",
                  "prompt",
                  "forbid"
                ]
              }
            },
            "required": [
              "prefix",
              "action"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "approvals": {
      "type": "string",
      "enum": [
        "untrusted",
        "on-request",
        "never"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high"
          ]
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxOutputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "no-os-sandbox",
              "degraded-provider",
              "validator-downgraded",
              "network-unrestricted"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sessionId",
    "sandbox",
    "approvals",
    "model"
  ],
  "additionalProperties": false
}
