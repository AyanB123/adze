{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "attachments": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "text"
              },
              "name": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "image"
              },
              "name": {
                "type": "string"
              },
              "mediaType": {
                "type": "string",
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/gif",
                  "image/webp"
                ]
              },
              "data": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "mediaType",
              "data"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxSteps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxWallClockMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxSpendUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "full-access"
          ]
        },
        "writableRoots": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedNetworkHosts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commandRules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "enum": [
                  "allow",
                  "prompt",
                  "forbid"
                ]
              }
            },
            "required": [
              "prefix",
              "action"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "approvals": {
      "type": "string",
      "enum": [
        "untrusted",
        "on-request",
        "never"
      ]
    }
  },
  "required": [
    "sessionId",
    "prompt"
  ],
  "additionalProperties": false
}
