{
  "cases": [
    {
      "id": "pg-ts-exact-const",
      "description": "TypeScript exact single-line edit: widen a constant declaration.",
      "path": "src/config.ts",
      "original": ["export const TIMEOUT_MS = 3000;", "export const RETRIES = 3;", ""],
      "edits": [
        {
          "search": "export const TIMEOUT_MS = 3000;",
          "replace": "export const TIMEOUT_MS = env.TIMEOUT ?? 3000;"
        }
      ],
      "expect": {
        "kind": "output",
        "content": [
          "export const TIMEOUT_MS = env.TIMEOUT ?? 3000;",
          "export const RETRIES = 3;",
          ""
        ],
        "strategy": "exact",
        "tier": "search-replace"
      },
      "tags": ["polyglot", "typescript", "edit-format", "exact"],
      "source": "Aider Polyglot subset sampling (40/225), synthetic"
    },
    {
      "id": "pg-ts-guard-clause",
      "description": "TypeScript multi-line edit: insert a guard clause before a lookup.",
      "path": "src/handler.ts",
      "original": [
        "export function handle(req: Request) {",
        "  const id = req.params.id;",
        "  return lookup(id);",
        "}",
        ""
      ],
      "edits": [
        {
          "search": "  const id = req.params.id;\n  return lookup(id);",
          "replace": "  const id = req.params.id;\n  if (!id) throw new Error('missing id');\n  return lookup(id);"
        }
      ],
      "expect": {
        "kind": "output",
        "content": [
          "export function handle(req: Request) {",
          "  const id = req.params.id;",
          "  if (!id) throw new Error('missing id');",
          "  return lookup(id);",
          "}",
          ""
        ],
        "strategy": "exact"
      },
      "tags": ["polyglot", "typescript", "edit-format", "exact"],
      "source": "Aider Polyglot subset sampling (40/225), synthetic"
    },
