{
  "cases": [
    {
      "id": "exact-single-line",
      "description": "A byte-identical single-line search block matches exactly.",
      "path": "src/server.ts",
      "original": ["const port = 3000;", "start(port);", ""],
      "edits": [{ "search": "const port = 3000;", "replace": "const port = env.PORT ?? 3000;" }],
      "expect": {
        "kind": "output",
        "content": ["const port = env.PORT ?? 3000;", "start(port);", ""],
        "strategy": "exact",
        "tier": "search-replace",
        "validator": "structural"
      },
      "tags": ["matching", "exact"]
    },
    {
      "id": "exact-multi-line-block",
      "description": "A multi-line block that matches byte-for-byte stays on the exact strategy.",
      "path": "src/handler.ts",
      "original": [
        "export function handle(req: Request) {",
        "  const id = req.params.id;",
        "  return lookup(id);",
        "}",
        ""
      ],
      "edits": [
        {
          "search": "  const id = req.params.id;\n  return lookup(id);",
          "replace": "  const id = req.params.id;\n  if (!id) throw new Error('missing id');\n  return lookup(id);"
        }
      ],
      "expect": {
        "kind": "output",
        "content": [
          "export function handle(req: Request) {",
          "  const id = req.params.id;",
          "  if (!id) throw new Error('missing id');",
          "  return lookup(id);",
          "}",
          ""
        ],
        "strategy": "exact"
      },
      "tags": ["matching", "exact"]
    },
    {
      "id": "whitespace-internal-run-collapsed",
      "description": "Internal whitespace runs differ; leading indentation is identical. Whitespace-normalized matching handles it.",
      "path": "src/config.ts",
      "original": ["const a   =    1;", ""],
      "edits": [{ "search": "const a = 1;", "replace": "const a = 2;" }],
      "expect": {
        "kind": "output",
        "content": ["const a = 2;", ""],
        "strategy": "whitespace-normalized"
      },
      "tags": ["matching", "whitespace"]
    },
    {
      "id": "whitespace-trailing-drift",
      "description": "The file has trailing whitespace on an interior line and the model did not reproduce it, which is routine. Exact matching fails because the newline no longer aligns; whitespace-normalized matching handles it because it trims line ends.",
      "path": "src/drift.ts",
      "original": ["function f() {", "  return 1;   ", "}", ""],
      "edits": [{ "search": "  return 1;\n}", "replace": "  return 2;\n}" }],
      "expect": {
        "kind": "output",
        "content": ["function f() {", "  return 2;", "}", ""],
        "strategy": "whitespace-normalized"
      },
      "tags": ["matching", "whitespace", "regression"]
    },
    {
      "id": "indentation-tolerant-reindents-replacement",
      "description": "A model quoted a method from the wrong nesting level. The match is located and the replacement is re-indented to the indentation actually found — inserting it at the model's level parses in braces languages and would be silently wrong.",
      "path": "src/klass.ts",
      "original": ["class A {", "  run() {", "    return 1;", "  }", "}", ""],
      "edits": [{ "search": "run() {\n  return 1;\n}", "replace": "run() {\n  return 2;\n}" }],
      "expect": {
        "kind": "output",
        "content": ["class A {", "  run() {", "    return 2;", "  }", "}", ""],
        "strategy": "indentation-tolerant"
      },
      "tags": ["matching", "indentation", "reindent"]
    },
    {
      "id": "indentation-tolerant-python-reindents",
      "description": "The same shift in Python, where wrong indentation is not merely ugly but a different program. Re-indentation must restore the file's real level.",
      "path": "app/service.py",
      "original": ["class Service:", "    def run(self):", "        return 1", ""],
      "edits": [
        { "search": "def run(self):\n    return 1", "replace": "def run(self):\n    return 2" }
      ],
      "expect": {
        "kind": "output",
        "content": ["class Service:", "    def run(self):", "        return 2", ""],
        "strategy": "indentation-tolerant"
      },
      "tags": ["matching", "indentation", "python"]
    },
    {
      "id": "indentation-relative-shape-must-still-match",
      "description": "Indentation tolerance allows a uniform shift only. Relative indentation inside the block must still match, so a block whose interior nesting differs is not found.",
      "path": "src/nested.ts",
      "original": ["class A {", "  run() {", "      return 1;", "  }", "}", ""],
      "edits": [{ "search": "run() {\n  return 1;\n}", "replace": "run() {\n  return 2;\n}" }],
      "expect": { "kind": "refusal", "reason": "not-found" },
      "tags": ["matching", "indentation", "safety"]
    },
    {
      "id": "anchored-with-elision-marker",
      "description": "A model deliberately elided the middle of a block and said so with '// ...'. Anchored matching splices the interior.",
      "path": "src/long.ts",
      "original": [
        "function outer() {",
        "  const a = 1;",
        "  const b = 2;",
        "  const c = 3;",
        "  return a + b + c;",
        "}",
        ""
      ],
      "edits": [
        {
          "search": "function outer() {\n  // ...\n  return a + b + c;\n}",
          "replace": "function outer() {\n  return 6;\n}"
        }
      ],
      "expect": {
        "kind": "output",
        "content": ["function outer() {", "  return 6;", "}", ""],
        "strategy": "anchored"
      },
      "tags": ["matching", "anchored"]
    },
    {
      "id": "anchored-requires-explicit-elision",
      "description": "The same shape without an elision marker must NOT anchor-match. Without that requirement, anchored matching would swallow almost any block whose first and last lines are unique — far too aggressive for a strategy that replaces everything in between.",
      "path": "src/long.ts",
      "original": [
        "function outer() {",
        "  const a = 1;",
        "  const b = 2;",
        "  return a + b;",
        "}",
        ""
      ],
      "edits": [
        {
          "search": "function outer() {\n  const q = 9;\n  return a + b;\n}",
          "replace": "function outer() {\n  return 3;\n}"
        }
      ],
      "expect": { "kind": "refusal", "reason": "not-found" },
      "tags": ["matching", "anchored", "safety"]
    },
    {
      "id": "anchored-ambiguous-anchors-refused",
      "description": "An elision marker is present but the closing anchor appears twice, so the span would be a guess. Refused rather than resolved.",
      "path": "src/twice.ts",
      "original": [
        "function a() {",
        "  const x = 1;",
        "  return x;",
        "}",
        "function b() {",
        "  const y = 2;",
        "  return x;",
        "}",
        ""
      ],
      "edits": [
        {
          "search": "function a() {\n  // ...\n  return x;\n}",
          "replace": "function a() {\n  return 1;\n}"
        }
      ],
      "expect": { "kind": "refusal", "reason": "not-found" },
      "tags": ["matching", "anchored", "safety"]
    },
    {
      "id": "crlf-file-exact-match",
      "description": "A CRLF file, which is the default on Windows checkouts. Line-oriented matching must not be defeated by the carriage returns.",
      "path": "src/crlf.ts",
      "original": "const a = 1;\r\nconst b = 2;\r\n",
      "edits": [{ "search": "const b = 2;", "replace": "const b = 3;" }],
      "expect": { "kind": "output", "content": "const a = 1;\r\nconst b = 3;\r\n" },
      "tags": ["matching", "line-endings", "windows"]
    }
  ]
}
