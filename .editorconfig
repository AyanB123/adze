root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,cmd,bat}]
end_of_line = crlf

# Patch files must never be touched by an editor. See .gitattributes.
[*.{patch,diff}]
insert_final_newline = false
trim_trailing_whitespace = false
