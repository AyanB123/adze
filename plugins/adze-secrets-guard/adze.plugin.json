{
  "$schema": "https://adze.dev/schema/plugin/v0.json",
  "id": "adze.secrets-guard",
  "version": "0.1.0",
  "displayName": "Secrets Guard",
  "description": "Denies any edit or file write that would commit a credential, and denies unreviewed changes to CI workflow files.",
  "license": "Apache-2.0",
  "repository": "https://github.com/AyanB123/adze",
  "engines": { "adze": ">=0.0.1 <1.0.0" },
  "contributes": {
    "hooks": [
      {
        "event": "edit.pre",
        "module": "hooks/guard.mjs",
        "runtime": "js",
        "timeoutMs": 500
      },
      {
        "event": "tool.pre",
        "module": "hooks/guard.mjs",
        "runtime": "js",
        "timeoutMs": 500
      }
    ]
  },
  "permissions": {
    "filesystem": "none"
  }
}
