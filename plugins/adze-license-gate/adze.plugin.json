{
  "$schema": "https://adze.dev/schema/plugin/v0.json",
  "id": "adze.license-gate",
  "version": "0.1.0",
  "displayName": "License Gate",
  "description": "Denies adding a dependency under a copyleft or source-available licence, and denies a dependency added without going through the version catalog.",
  "license": "Apache-2.0",
  "repository": "https://github.com/AyanB123/adze",
  "engines": { "adze": ">=0.0.1 <1.0.0" },
  "contributes": {
    "hooks": [
      {
        "event": "edit.pre",
        "module": "hooks/gate.mjs",
        "runtime": "js",
        "timeoutMs": 500
      },
      {
        "event": "tool.pre",
        "module": "hooks/gate.mjs",
        "runtime": "js",
        "timeoutMs": 500
      }
    ]
  },
  "permissions": {
    "filesystem": "none"
  }
}
