{
  "$schema": "https://adze.dev/schema/plugin/v0.json",
  "id": "acme.migration-guard",
  "version": "1.2.0",
  "displayName": "Migration Guard",
  "description": "Requires human review before any database migration is written, and normalizes npm invocations to pnpm.",
  "license": "Apache-2.0",
  "repository": "https://github.com/AyanB123/adze",
  "engines": { "adze": ">=0.0.1 <1.0.0" },
  "contributes": {
    "hooks": [
      {
        "event": "edit.pre",
        "module": "hooks/policy.mjs",
        "runtime": "js",
        "timeoutMs": 500
      },
      {
        "event": "tool.pre",
        "module": "hooks/policy.mjs",
        "runtime": "js",
        "timeoutMs": 500
      }
    ]
  },
  "permissions": {
    "filesystem": "none"
  }
}
